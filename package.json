{
  "name": "formie-plugin-workspace",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.3"
  },
  "overrides": {
    "locutus": "^3.0.36",
    "@tiptap/core": "3.22.4",
    "@tiptap/extension-blockquote": "3.22.4",
    "@tiptap/extension-bold": "3.22.4",
    "@tiptap/extension-bullet-list": "3.22.4",
    "@tiptap/extension-code": "3.22.4",
    "@tiptap/extension-code-block": "3.22.4",
    "@tiptap/extension-document": "3.22.4",
    "@tiptap/extension-dropcursor": "3.22.4",
    "@tiptap/extension-gapcursor": "3.22.4",
    "@tiptap/extension-hard-break": "3.22.4",
    "@tiptap/extension-heading": "3.22.4",
    "@tiptap/extension-highlight": "3.22.4",
    "@tiptap/extension-history": "3.22.4",
    "@tiptap/extension-horizontal-rule": "3.22.4",
    "@tiptap/extension-italic": "3.22.4",
    "@tiptap/extension-link": "3.22.4",
    "@tiptap/extension-list": "3.22.4",
    "@tiptap/extension-list-item": "3.22.4",
    "@tiptap/extension-ordered-list": "3.22.4",
    "@tiptap/extension-paragraph": "3.22.4",
    "@tiptap/extension-strike": "3.22.4",
    "@tiptap/extension-subscript": "3.22.4",
    "@tiptap/extension-superscript": "3.22.4",
    "@tiptap/extension-table": "3.22.4",
    "@tiptap/extension-table-cell": "3.22.4",
    "@tiptap/extension-table-header": "3.22.4",
    "@tiptap/extension-table-row": "3.22.4",
    "@tiptap/extension-text": "3.22.4",
    "@tiptap/extension-text-align": "3.22.4",
    "@tiptap/extension-text-style": "3.22.4",
    "@tiptap/extension-underline": "3.22.4",
    "@tiptap/extensions": "3.22.4",
    "@tiptap/pm": "3.22.4",
    "vitepress": {
      "vite": "^6.4.3"
    },
    "@vitejs/plugin-vue": {
      "vite": "^6.4.3"
    },
    "@tiptap/react": "3.22.4",
    "@tiptap/extension-bubble-menu": "3.22.4",
    "@tiptap/extension-floating-menu": "3.22.4"
  },
  "workspaces": [
    "packages/*",
    "src/web/assets/cp",
    "src/web/assets/frontend"
  ],
  "scripts": {
    "release": "node ./scripts/release.mjs",
    "release:patch": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "rebuild:assets": "node ./scripts/rebuild-assets.mjs",
    "dev": "npm run dev:cp & npm run dev:frontend & wait",
    "dev:docs": "npm run docs:dev -w @verbb/formie-frontend-docs",
    "dev:plugin-docs": "npm run docs:dev --prefix docs",
    "docs:screenshots": "npm --prefix docs run docs:screenshots --",
    "dev:cp": "npm run dev -w formie-cp",
    "dev:frontend": "npm run dev -w formie-frontend",
    "build": "npm run build:cp && npm run build:frontend",
    "build:docs": "npm run docs:build -w @verbb/formie-frontend-docs",
    "build:packages": "npm run build -w @verbb/formie-core && npm run build -w @verbb/formie-browser && npm run build -w @verbb/formie-react && npm run build -w @verbb/formie-vue && npm run build -w @verbb/formie-web-components",
    "build:cp": "npm run build -w formie-cp",
    "build:frontend": "npm run build:formie-browser && npm run build -w formie-frontend",
    "build:formie-core": "npm run build -w @verbb/formie-core",
    "build:formie-browser": "npm run build:formie-core && npm run build -w @verbb/formie-browser",
    "build:formie-react": "npm run build:formie-browser && npm run build -w @verbb/formie-react",
    "build:formie-vue": "npm run build:formie-browser && npm run build -w @verbb/formie-vue",
    "build:formie-web-components": "npm run build:formie-browser && npm run build -w @verbb/formie-web-components",
    "test": "npm run test -w @verbb/formie-core && npm run test -w formie-cp",
    "test:browser": "npm run build && node tests/browser/build.mjs && playwright test --config tests/browser/playwright.config.ts"
  },
  "dependencies": {
    "@verbb/plugin-kit-codemirror-core": "^2.0.18",
    "@verbb/plugin-kit-core": "^2.0.18",
    "@verbb/plugin-kit-forms": "^2.0.18",
    "@verbb/plugin-kit-icons": "^2.0.18",
    "@verbb/plugin-kit-react": "^2.0.18",
    "@verbb/plugin-kit-tiptap-core": "^2.0.18",
    "@verbb/plugin-kit-web": "^2.0.18"
  }
}
